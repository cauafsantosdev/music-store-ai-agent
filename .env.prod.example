# Private VPS configuration template. Copy to /opt/apps/music-store-ai-agent/.env.prod.
# Never commit the filled copy. Keep the same browser key across image updates.
# Verify that this hostname resolves to the VPS before enabling HTTPS.
APP_DOMAIN=emporio-da-musica.cauafsantos.dev
PGDATABASE=music_store_agent
PGUSER=music_store_agent
PGPASSWORD=
GROQ_API_KEY=
BROWSER_SESSION_KEY=

# All seven original source files must be readable by container UID 10001.
# A read-only Docker mount does not override filesystem permissions.
CHALLENGE_SOURCE_DIRECTORY=/opt/apps/music-store-ai-agent/data/private

# Persistent admission controls; these are application budgets, not Groq quotas.
AI_SESSION_REQUEST_LIMIT=20
AI_DAILY_MODEL_CALL_LIMIT=100
AI_MAX_CONCURRENT_TURNS=1

# IMAGE_TAG belongs in .release.env and must be the complete 40-character commit SHA.
# Browser origins, HTTPS-only cookies, dataset mode and admission enablement are
# deliberately fixed by compose.prod.yaml rather than configurable insecure flags.
