# Non-production examples for local development only. Copy to .env before startup.
POSTGRES_DB=music_store_dev
POSTGRES_USER=music_store_dev
POSTGRES_PASSWORD=local_dev_only_change_me

# The API receives PGHOST=db, PGPORT=5432, and PGDATABASE/PGUSER/PGPASSWORD
# from Compose. psycopg can use these connection components directly.

# Internal Docker address; localhost would refer to the frontend container.
BACKEND_URL=http://api:8000
BACKEND_TIMEOUT_SECONDS=5
# Bounded response wait for complete agent turns, including multiple model calls.
BACKEND_READ_TIMEOUT_SECONDS=180

# Stable Fernet key shared only by API and Streamlit servers; generate once locally.
BROWSER_SESSION_KEY=
# Local browser hosts must match; production uses the same HTTPS origin for both.
BROWSER_APP_ORIGIN=http://localhost:8501
BROWSER_SESSION_API_ORIGIN=http://localhost:8000
# Enable only for explicit localhost HTTP development; keep false for HTTPS.
BROWSER_SESSION_ALLOW_HTTP_LOCALHOST=false

# Host ports bound to localhost. Change these if another service uses the defaults.
API_PORT=8000
WEB_PORT=8501

# GroqCloud API access using a free-plan key; blank keys keep the foundation usable.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Default public fixtures; challenge also requires compose.challenge.yaml and sources.
AI_DATASET_MODE=sample
# Blank uses agent_demo / agent_state in sample mode and the _challenge suffix
# in challenge mode. Initialize explicitly with --init-demo and --init-state.
AI_DEMO_SCHEMA=
AI_STATE_SCHEMA=
# Used only by the explicit challenge override; files are mounted read-only.
CHALLENGE_SOURCE_DIRECTORY=./data/private
AI_MAX_MODEL_CALLS=4
AI_MAX_TOOL_CALLS=6
AI_RECURSION_LIMIT=24
AI_MAX_OUTPUT_TOKENS=2048
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=60

# Local admission is optional; production requires these persistent safeguards.
# Run --init-state after enabling to create the usage counters explicitly.
AI_ADMISSION_ENABLED=false
AI_SESSION_REQUEST_LIMIT=20
AI_DAILY_MODEL_CALL_LIMIT=100
AI_MAX_CONCURRENT_TURNS=1
