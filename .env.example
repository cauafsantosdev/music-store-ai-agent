# Non-production examples for local development only. Copy to .env before startup.
POSTGRES_DB=music_store_dev
POSTGRES_USER=music_store_dev
POSTGRES_PASSWORD=local_dev_only_change_me

# The API receives PGHOST=db, PGPORT=5432, and PGDATABASE/PGUSER/PGPASSWORD
# from Compose. psycopg can use these connection components directly.

# Internal Docker address; localhost would refer to the frontend container.
BACKEND_URL=http://api:8000
BACKEND_TIMEOUT_SECONDS=5

# Host ports bound to localhost. Change these if another service uses the defaults.
API_PORT=8000
WEB_PORT=8501
